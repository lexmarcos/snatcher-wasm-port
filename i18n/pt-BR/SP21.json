    "0412": {"h": "60b7374e", "t": "Estamos na sala do Chefe."},
    "0804": {"h": "ea36e7fe", "t": "Aplicando uma leve corrente ao{nl}revestimento eletrocrômico de{nl}tungstênio do vidro, a cor pode{nl}ser ajustada de perfeitamente{nl}transparente a quase opaca."},
    "1c40": {"h": "4749792d", "t": ".........."},
    "1cf3": {"h": "4749792d", "t": ".........."},
    "1d04": {"h": "1ddb9c2f", "t": "Hã?"},
    "1db4": {"h": "cf4071cb", "t": "Entendo."},
    "297b": {"h": "6d6f1950", "t": "Esta é a recepção."},
    "2b93": {"h": "28e6f98d", "t": "Aonde vamos?"},
    "3286": {"h": "b9bee0a9", "t": "O que foi, Gillian?"},
    "36e7": {"h": "67cfa2c8", "t": "Não consigo acreditar..."},
    "43d2": {"h": "84d88ae5", "t": "Que é isso?"},
    "4772": {"h": "93f8739c", "t": "Gillian?"},
    "4b6b": {"h": "277ae89a", "t": "Esta é a engenharia."},
    "6b7e": {"h": "1664cede", "t": "Este é o estande de tiro."},
    "7337": {"h": "93f8739c", "t": "Gillian?"},
    "7340": {"h": "29829b50", "t": "Que foi?"},
    "75b4": {"h": "3e1e3a55", "t": "Esta é a sua carteira Junker. Ela{nl}lhe dá todos os seus privilégios{nl}especiais. Cuide bem dela."},
    "760c": {"h": "8c0413d6", "t": "Esse é o dinheiro para despesas{nl}que a agência lhe deu."},
    "769d": {"h": "75d82c19", "t": "Essa é a peça de xadrez que o{nl}Gibson tinha."},
    "7896": {"h": "f3df227a", "t": "Tem um chip de circuito integrado{nl}embutido com todos os seus dados{nl}pessoais."},
    "78db": {"h": "e07bb31f", "t": "Em princípio, você pode cobrar da{nl}agência todo o dinheiro necessário{nl}para a sua investigação."},
    "798f": {"h": "6825e171", "t": "Essa é uma peça de xadrez de{nl}madeira. Creio que seja a que{nl}fica ao lado do rei."},
    "7d7c": {"h": "a1ef9c1a", "t": "Isso mesmo."},
    "7d8a": {"h": "27e40469", "t": "Certo, vou salvar tudo o que{nl}aconteceu até agora."},
    "7dca": {"h": "02041057", "t": "Em qual número de arquivo quer{nl}salvar?"},
    "7dfa": {"h": "19ad05d9", "t": "Este arquivo contém dados de um{nl}save anterior."},
    "7e28": {"h": "3b76ada6", "t": "Posso {c3}sobrescrever{c1} com os novos{nl}dados?"},
    "7e5f": {"h": "a4413f9f", "t": "Nesse caso, não vou salvar os{nl}novos dados aí."}
  }
